# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env ASLA GitHub'a yüklenmez.

# development (DEBUG açık) | production (DEBUG kapalı). Render'da production yazın.
FLASK_ENV=development
SECRET_KEY=rastgele-uzun-bir-sifre-yazin

# Yapay zekâ: iki sağlayıcı sırayla denenir. İlkinden geçerli cevap alınamazsa (kota, zaman aşımı,
# sunucu hatası, boş cevap) sıradakine geçilir. Anahtarı boş olan sağlayıcı atlanır;
# ikisi de boşsa sistem demo modunda çalışır.
# Ana sağlayıcı Gemini, yedek Groq. Sırayı değiştirmek için: AI_PROVIDER_ORDER=groq,gemini
AI_PROVIDER_ORDER=gemini,groq
# Gemini (https://aistudio.google.com/apikey) - ana sağlayıcı
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Groq (https://console.groq.com) - Gemini çalışmazsa devreye girer
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# gpt-oss düşünen modeldir: low | medium | high. Düşünmeyen bir model seçerseniz boş bırakın.
AI_REASONING_EFFORT=low
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=800
# İstek başına ve tüm sağlayıcılar için toplam süre (saniye). Toplam 30'un altında kalmalı (gunicorn sınırı)
AI_TIMEOUT=10
AI_TOTAL_TIMEOUT=25
AI_HISTORY_MAX_MESSAGES=6
AI_HISTORY_MAX_CHARS=2400
# Günlük toplam token sınırı; aşılınca Groq'a gidilmez
AI_DAILY_TOKEN_BUDGET=300000

# Kötüye kullanım koruması
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_MESSAGE_MAX_CHARS=1000
LEAD_RATE_LIMIT_REQUESTS=5
LEAD_RATE_LIMIT_WINDOW_SECONDS=600
MAX_CONTENT_LENGTH=65536

DATABASE_URL=onbuddy.db

# Geliştirmede *, canlıda Wix sitenizin adresi (birden fazlaysa virgülle):
# CORS_ORIGINS=https://kullaniciadi.wixstudio.com,https://www.onbuddy.com
CORS_ORIGINS=*

# Doluysa GET /api/leads için X-Admin-Token başlığı gerekir (boş = herkese açık)
ADMIN_TOKEN=
