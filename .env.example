# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env ASLA GitHub'a yüklenmez.

# development (DEBUG açık) | production (DEBUG kapalı). Render'da production yazın.
FLASK_ENV=development
SECRET_KEY=rastgele-uzun-bir-sifre-yazin

# Yapay zekâ: Groq (https://console.groq.com). Anahtar boşsa demo modunda çalışır.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Ana model kota (429) verirse veya erişilemezse (404) bir kez bununla denenir; boş bırakılırsa denenmez
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# gpt-oss düşünen modeldir: low | medium | high. Düşünmeyen bir model seçerseniz boş bırakın.
AI_REASONING_EFFORT=low
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=800
AI_TIMEOUT=15
AI_HISTORY_MAX_MESSAGES=6
AI_HISTORY_MAX_CHARS=2400
# Günlük toplam token sınırı; aşılınca Groq'a gidilmez
AI_DAILY_TOKEN_BUDGET=300000

# RAG: her soruda kaç bilgi parçası gönderilsin, bir parça en fazla kaç karakter olsun
RAG_TOP_K=4
RAG_MAX_CHUNK_CHARS=800
# Pozisyon tablosu boşsa knowledge/ornek_pozisyonlar.json (mock) ile doldurulur. Gerçek ilanlar gelince 0 yapın.
ORNEK_POZISYONLARI_YUKLE=1

# Kötüye kullanım koruması
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_MESSAGE_MAX_CHARS=1000
MAX_CONTENT_LENGTH=65536

DATABASE_URL=onbuddy.db

# Geliştirmede *, canlıda Wix sitenizin adresi (birden fazlaysa virgülle):
# CORS_ORIGINS=https://kullaniciadi.wixstudio.com,https://www.onbuddy.com
CORS_ORIGINS=*

# Doluysa GET /api/leads için X-Admin-Token başlığı gerekir (boş = herkese açık)
ADMIN_TOKEN=
